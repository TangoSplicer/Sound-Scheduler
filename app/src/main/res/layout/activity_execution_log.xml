<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface"
    android:orientation="vertical"
    android:padding="@dimen/screen_content_padding">

    <TextView
        android:id="@+id/activityLogTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/activity_log_title"
        android:textAppearance="@style/TextAppearance.App.Title" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/activity_log_subtitle"
        android:textAppearance="@style/TextAppearance.App.BodyMuted" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/showAllExecutionsButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/activity_filter_all"
            android:textAllCaps="false" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/showAttentionExecutionsButton"
            style="@style/Widget.App.QuickAction"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="@string/activity_filter_attention"
            android:textAllCaps="false" />
    </LinearLayout>

    <ListView
        android:id="@+id/executionListView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:divider="@android:color/transparent"
        android:dividerHeight="8dp" />

    <TextView
        android:id="@+id/executionEmptyStateTextView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_gravity="center"
        android:layout_weight="1"
        android:gravity="center"
        android:padding="32dp"
        android:text="@string/activity_log_empty"
        android:textAppearance="@style/TextAppearance.App.EmptyState"
        android:visibility="gone" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/clearExecutionHistoryButton"
        style="@style/Widget.App.QuickAction"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/clear_activity_history"
        android:textAllCaps="false" />

</LinearLayout>
