<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp">

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/routine_name_hint">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/routineNameEditText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:imeOptions="actionDone"
            android:inputType="textCapSentences"
            android:maxLength="100" />
    </com.google.android.material.textfield.TextInputLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="@string/sound_mode_label"
        android:textAppearance="@style/TextAppearance.App.FormLabel" />

    <Spinner
        android:id="@+id/soundModeSpinner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:entries="@array/sound_mode_options" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/schedule_time_label"
        android:textAppearance="@style/TextAppearance.App.FormLabel" />

    <TimePicker
        android:id="@+id/routineTimePicker"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:timePickerMode="spinner" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/repeat_label"
        android:textAppearance="@style/TextAppearance.App.FormLabel" />

    <Spinner
        android:id="@+id/recurrenceSpinner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:entries="@array/recurrence_options" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/routine_editor_note"
        android:textAppearance="@style/TextAppearance.App.BodyMuted" />

</LinearLayout>
